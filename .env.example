# Application Environment Variables
PORT=5000
NODE_ENV=production

# Database Connection URL (Optional if using Cloud PostgreSQL such as Supabase / Neon / Render Postgres)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-HOST]:5432/postgres?sslmode=require

# Alternatively, if using Turso (Cloud SQLite):
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your-token
